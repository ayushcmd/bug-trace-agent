# --- AI Provider Configuration ---
# Option 1: Google AI Studio Gemini API Key (Recommended for easy setup)
GEMINI_API_KEY=your-gemini-api-key-here

# Option 2: Google Cloud Vertex AI (For enterprise / Cloud Run deployment)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Option 3: Offline Sandbox / Demo Mode (Set to true to run fully offline without any API keys)
DEMO_MODE=false

# --- Server & Application Settings ---
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR
